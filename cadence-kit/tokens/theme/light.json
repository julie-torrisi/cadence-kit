      },
      "inverted": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.lightest}",
        "$description": "inverted text color"
      },
      "subtle": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.strong}",
        "$description": "subtle text color"
      },
      "link": {
        "$type": "color",
        "$value": "{brand.color.role.main.primary.bold}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "TEXT_FILL"
            ]
          }
        }
      }
    },
    "state": {
      "disable": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.medium}",
        "$description": "background for disabled elements"
      },
      "onDisable": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.dark}",
        "$description": "color for elements on a disabled background"
      },
      "hover": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0471,
            0.0392,
            0.0353
          ],
          "alpha": 0.1608,
          "hex": "#0c0a09"
        },
        "$description": "state overlay for hovered elements"
      },
      "press": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.0471,
            0.0392,
            0.0353
          ],
          "alpha": 0.0784,
          "hex": "#0c0a09"
        },
        "$description": "state overlay for pressed elements"
      },
      "select": {
        "$type": "color",
        "$value": "{brand.color.role.main.primary.light}"
      },
      "onSelect": {
        "$type": "color",
        "$value": "{brand.color.role.main.primary.bold}"
      },
      "selectInverted": {
        "$type": "color",
        "$value": "{brand.color.role.main.primary.bold}"
      },
      "onSelectInverted": {
        "$type": "color",
        "$value": "{brand.color.role.main.primary.light}"
      }
    },
    "border": {
      "subtle": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.light}"
      },
      "medium": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.medium}"
      },
      "heavy": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.strong}"
      },
      "focusOutline": {
        "$type": "color",
        "$value": "{brand.color.role.main.primary.strong}",
        "$description": "default focus outline color"
      }
    },
    "icon": {
      "default": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.darkest}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "SHAPE_FILL",
              "STROKE_COLOR"
            ]
          }
        }
      },
      "hover": {
        "$type": "color",
        "$value": "{brand.color.role.main.primary.strong}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "SHAPE_FILL",
              "STROKE_COLOR"
            ]
          }
        }
      },
      "glow": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0.2275,
            0.4353,
            0.7961
          ],
          "alpha": 0.349,
          "hex": "#3a6fcb"
        },
        "$extensions": {
          "com.figma": {
            "scopes": [
              "EFFECT_COLOR"
            ]
          }
        }
      },
      "success": {
        "$type": "color",
        "$value": "{brand.color.role.intent.success.bold}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "SHAPE_FILL",
              "STROKE_COLOR"
            ]
          }
        }
      },
      "critical": {
        "$type": "color",
        "$value": "{brand.color.role.intent.critical.bold}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "SHAPE_FILL",
              "STROKE_COLOR"
            ]
          }
        }
      }
    },
    "board": {
      "background": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.lightest}"
      },
      "dot": {
        "$type": "color",
        "$value": "{brand.color.role.neutral.light}"
      }
    }
