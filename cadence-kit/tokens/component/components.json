{
  "component": {
    "button": {
      "height": {
        "$type": "dimension",
        "$value": "{alias.size.target}"
      },
      "paddingX": {
        "$type": "dimension",
        "$value": "{alias.space.md}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{alias.radius.md}"
      },
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{alias.color.primary.interaction}"
        },
        "text": {
          "$type": "color",
          "$value": "{alias.color.primary.onInteraction}"
        }
      },
      "secondary": {
        "background": {
          "$type": "color",
          "$value": "{alias.color.secondary.interaction}"
        },
        "text": {
          "$type": "color",
          "$value": "{alias.color.secondary.onInteraction}"
        }
      }
    },
    "push": {
      "padding": {
        "$type": "dimension",
        "$value": "{alias.space.sm}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{pairing.level4.gap}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{alias.radius.lg}"
      },
      "background": {
        "$type": "color",
        "$value": "{alias.color.background.highEmphasis}"
      }
    },
    "banner": {
      "paddingX": {
        "$type": "dimension",
        "$value": "{alias.space.md}"
      },
      "paddingY": {
        "$type": "dimension",
        "$value": "{alias.space.sm}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{alias.space.sm}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{alias.radius.md}"
      },
      "background": {
        "$type": "color",
        "$value": "{alias.color.background.highEmphasis}"
      },
      "border": {
        "$type": "color",
        "$value": "{alias.color.border.subtle}"
      }
    },
    "modal": {
      "padding": {
        "$type": "dimension",
        "$value": "{alias.space.lg}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{alias.space.md}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{alias.radius.lg}"
      },
      "background": {
        "$type": "color",
        "$value": "{alias.color.background.highEmphasis}"
      },
      "scrim": {
        "$type": "color",
        "$value": "{alias.color.background.overlay}"
      }
    },
    "toast": {
      "paddingX": {
        "$type": "dimension",
        "$value": "{alias.space.md}"
      },
      "paddingY": {
        "$type": "dimension",
        "$value": "{alias.space.sm}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{alias.radius.md}"
      },
      "background": {
        "$type": "color",
        "$value": "{alias.color.background.inverted}"
      },
      "text": {
        "$type": "color",
        "$value": "{alias.color.text.inverted}"
      }
    },
    "input": {
      "padding": {
        "$type": "dimension",
        "$value": "{alias.space.sm}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{alias.space.xs}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{alias.radius.md}"
      },
      "background": {
        "$type": "color",
        "$value": "{alias.color.background.body}"
      },
      "border": {
        "$type": "color",
        "$value": "{alias.color.border.heavy}"
      },
      "borderWidth": {
        "$type": "dimension",
        "$value": "{alias.borderWidth.xs}"
      },
      "focusRing": {
        "$type": "color",
        "$value": "{alias.color.border.focusOutline}"
      }
    },
    "loader": {
      "dotSize": {
        "$type": "dimension",
        "$value": "{alias.space.3xs}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{alias.space.2xs}"
      },
      "dotActive": {
        "$type": "color",
        "$value": "{alias.color.primary.interaction}"
      },
      "dotIdle": {
        "$type": "color",
        "$value": "{alias.color.border.medium}"
      },
      "barWidth": {
        "$type": "dimension",
        "$value": "{alias.space.sm}"
      },
      "barRadius": {
        "$type": "dimension",
        "$value": {
          "value": 999,
          "unit": "px"
        }
      }
    },
    "sectionMessage": {
      "height": {
        "min": {
          "$type": "dimension",
          "$value": "{alias.size.md}"
        }
      },
      "spacing": {
        "innerY": {
          "$type": "dimension",
          "$value": "{alias.space.md}"
        },
        "innerX": {
          "$type": "dimension",
          "$value": "{alias.space.sm}"
        },
        "gap": {
          "$type": "dimension",
          "$value": "{alias.space.xs}"
        }
      },
      "borderRadius": {
        "$type": "dimension",
        "$value": "{alias.radius.md}"
      },
      "success": {
        "background": {
          "$type": "color",
          "$value": "{alias.color.intent.successHighEmphasis}"
        },
        "text": {
          "$type": "color",
          "$value": "{alias.color.intent.onSuccess}"
        },
        "icon": {
          "$type": "color",
          "$value": "{alias.color.intent.onSuccess}"
        }
      },
      "warning": {
        "background": {
          "$type": "color",
          "$value": "{alias.color.intent.warningHighEmphasis}"
        },
        "text": {
          "$type": "color",
          "$value": "{alias.color.intent.onWarning}"
        },
        "icon": {
          "$type": "color",
          "$value": "{alias.color.intent.onWarning}"
        }
      }
    },
    "stack": {
      "gap": {
        "$type": "dimension",
        "$value": "{alias.space.xs}"
      }
    },
    "icon": {
      "default": {
        "$type": "color",
        "$value": "{alias.color.icon.default}"
      },
      "hover": {
        "$type": "color",
        "$value": "{alias.color.icon.hover}"
      },
      "glow": {
        "$type": "color",
        "$value": "{alias.color.icon.glow}"
      },
      "success": {
        "$type": "color",
        "$value": "{alias.color.icon.success}"
      },
      "critical": {
        "$type": "color",
        "$value": "{alias.color.icon.critical}"
      },
      "dimOpacity": {
        "$type": "number",
        "$value": 30,
        "$description": "Opacity in percent for dimmed animation frames"
      }
    },
    "pager": {
      "$description": "Pager (10/26): one pagination for carousels (inline) and the deck rail. Pages are squares of mesh dots on an unlit dot board, styled like the dot-visual donut. Replaces the 10/23 pill pager.",
      "target": {
        "$type": "dimension",
        "$value": "{alias.size.target}",
        "$description": "Hit area for arrows and the board"
      },
      "pitch": {
        "$type": "dimension",
        "$value": "{alias.board.pitch}"
      },
      "pitchCompact": {
        "$type": "dimension",
        "$value": "{alias.board.pitchCompact}"
      },
      "dot": {
        "$type": "dimension",
        "$value": "{alias.board.dot}"
      },
      "mark": {
        "$type": "number",
        "$value": 2,
        "$description": "Cells per side of a page square"
      },
      "gap": {
        "$type": "number",
        "$value": 1,
        "$description": "Empty board cells between page squares"
      },
      "margin": {
        "$type": "number",
        "$value": 3,
        "$description": "Board cells past the squares on every side"
      },
      "field": {
        "$type": "color",
        "$value": "{alias.color.board.unlit}"
      },
      "ahead": {
        "$type": "color",
        "$value": "{alias.color.board.ahead}"
      },
      "passed": {
        "$type": "color",
        "$value": "{alias.color.board.passed}"
      },
      "current": {
        "$type": "color",
        "$value": "{alias.color.board.current}"
      },
      "arrow": {
        "$type": "color",
        "$value": "{alias.color.text.default}"
      },
      "arrowHover": {
        "$type": "color",
        "$value": "{alias.color.board.current}",
        "$description": "Arrow hover lights to the current color with a glow, like the kit dot icons' Hover state"
      },
      "text": {
        "$type": "color",
        "$value": "{alias.color.text.subtle}"
      },
      "textCurrent": {
        "$type": "color",
        "$value": "{alias.color.text.default}"
      }
    }
  }
}
