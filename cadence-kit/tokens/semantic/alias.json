          "$type": "dimension",
          "$value": "{screen.layout.paddingLeftRight}"
        }
      }
    },
    "board": {
      "pitch": {
        "$type": "dimension",
        "$value": {
          "value": 5,
          "unit": "px"
        },
        "$description": "Dot Board grid pitch"
      },
      "dot": {
        "$type": "dimension",
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "Dot Board dot size"
      }
