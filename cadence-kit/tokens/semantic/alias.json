        "hover": {
          "$type": "color",
          "$value": "{mode.icon.hover}"
        },
        "glow": {
          "$type": "color",
          "$value": "{mode.icon.glow}"
        },
        "success": {
          "$type": "color",
          "$value": "{mode.icon.success}"
        },
        "critical": {
          "$type": "color",
          "$value": "{mode.icon.critical}"
        }
      },
      "board": {
        "background": {
          "$type": "color",
          "$value": "{mode.board.background}",
          "$description": "Dot Board stage"
        },
        "dot": {
          "$type": "color",
          "$value": "{mode.board.dot}",
          "$description": "Dot Board idle dot"
        }
      }
