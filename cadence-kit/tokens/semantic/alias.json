{
  "alias": {
    "borderWidth": {
      "xs": {
        "$type": "dimension",
        "$value": "{borderWidth.xs}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "STROKE_FLOAT"
            ]
          }
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": "{borderWidth.sm}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "STROKE_FLOAT"
            ]
          }
        }
      },
      "md": {
        "$type": "dimension",
        "$value": "{borderWidth.md}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "STROKE_FLOAT"
            ]
          }
        }
      }
    },
    "radius": {
      "none": {
        "$type": "dimension",
        "$value": "{radius.none}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "CORNER_RADIUS"
            ]
          }
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": "{radius.sm}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "CORNER_RADIUS"
            ]
          }
        }
      },
      "md": {
        "$type": "dimension",
        "$value": "{radius.md}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "CORNER_RADIUS"
            ]
          }
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": "{radius.lg}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "CORNER_RADIUS"
            ]
          }
        }
      }
    },
    "color": {
