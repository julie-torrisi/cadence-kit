        },
        "subtle": {
          "$type": "color",
          "$value": "{mode.text.subtle}"
        },
        "link": {
          "$type": "color",
          "$value": "{mode.text.link}"
        }
      },
      "state": {
        "disable": {
          "$type": "color",
          "$value": "{mode.state.disable}"
        },
        "onDisable": {
          "$type": "color",
          "$value": "{mode.state.onDisable}"
        },
        "hover": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.0471,
              0.0392,
              0.0353
            ],
            "alpha": 0.1608,
            "hex": "#0c0a09"
          }
        },
        "press": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [
              0.0471,
              0.0392,
              0.0353
            ],
            "alpha": 0.0784,
            "hex": "#0c0a09"
          }
        },
        "select": {
          "$type": "color",
          "$value": "{mode.state.select}"
        },
        "onSelect": {
          "$type": "color",
          "$value": "{mode.state.onSelect}"
        },
        "selectInverted": {
          "$type": "color",
          "$value": "{mode.state.selectInverted}"
        },
        "onSelectInverted": {
          "$type": "color",
          "$value": "{mode.state.onSelectInverted}"
        }
      },
