        "subtle": {
          "$type": "color",
          "$value": "{mode.border.subtle}"
        },
        "medium": {
          "$type": "color",
          "$value": "{mode.border.medium}"
        },
        "heavy": {
          "$type": "color",
          "$value": "{mode.border.heavy}"
        },
        "focusOutline": {
          "$type": "color",
          "$value": "{mode.border.focusOutline}"
